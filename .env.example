# ── Copy this file to .env and fill in real values ────────────────────────────
# .env is gitignored. NEVER commit real credentials.

# App
ENV=development
DEBUG=true
SECRET_KEY=change_me_to_64_random_chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxxx
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# PostgreSQL
POSTGRES_USER=ironlink_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ironlink

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# Object storage (S3-compatible: MinIO locally, Cloudflare R2 in production)
# The endpoint is host[:port] with NO scheme — S3_SECURE decides http vs https.
#
# Local MinIO (docker-compose) — the defaults below.
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY_ID=ironlink_minio
S3_SECRET_ACCESS_KEY=STRONG_MINIO_PASSWORD_HERE
S3_SECURE=false
S3_REGION=
S3_BUCKET_AVATARS=avatars
S3_BUCKET_ATTACHMENTS=attachments

# Cloudflare R2 — swap the four values above for these.
# Account ID: Cloudflare dashboard > R2 > it is in the S3 API endpoint URL.
# Keys: R2 > Manage API Tokens > Create token, scoped to these two buckets only.
#   S3_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
#   S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
#   S3_SECURE=true
#   S3_REGION=auto        # required — R2 rejects SigV4 signed with any other region
#
# Create both buckets in the dashboard first; the R2 token normally cannot
# create them. Keep them PRIVATE — do not attach a public r2.dev domain, or the
# pre-signed URL expiry becomes meaningless.

# Encryption (column-level, min 32 chars)
DB_ENCRYPTION_KEY=change_me_to_32_or_more_random_chars_here

# Firebase (for push notifications) — path to the downloaded service-account JSON.
# Empty = pushes silently disabled (fine for local dev).
FIREBASE_CREDENTIALS_FILE=./secrets/firebase-service-account.json

# On a hosted platform there is no file to point at — paste the service-account
# JSON itself into this single variable instead. It wins over the path above.
# Must be the whole document on one line:  FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS_JSON=

# ── AI (Hugging Face Inference API) ───────────────────────────────────────────
# Powers /ai/smart-replies, /ai/translate, /ai/moderate and the chat summary.
# Empty = those endpoints still answer, using their built-in fallbacks.
HF_API_TOKEN=