# ── Copy this file to .env and fill in real values ────────────────────────────
# .env is gitignored. NEVER commit real credentials.

# App
ENV=development
DEBUG=true
SECRET_KEY=change_me_to_64_random_chars_minimum_xxxxxxxxxxxxxxxxxxxxxxxxxxx
ALLOWED_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# PostgreSQL
POSTGRES_USER=ironlink_user
POSTGRES_PASSWORD=STRONG_PASSWORD_HERE
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ironlink

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# MinIO
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=ironlink_minio
MINIO_ROOT_PASSWORD=STRONG_MINIO_PASSWORD_HERE
MINIO_SECURE=false

# Encryption (column-level, min 32 chars)
DB_ENCRYPTION_KEY=change_me_to_32_or_more_random_chars_here

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"