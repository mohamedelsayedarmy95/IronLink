<?xml version="1.0" encoding="utf-8"?>
<!--
  TLS only. There is no exception here, and there is nothing to remember to
  remove before a release.

  This file used to carry a <domain-config> permitting cleartext to a
  developer's LAN address, the emulator loopback and localhost, with a comment
  asking whoever shipped the release to delete it first. That is a control
  that works right up until the once it does not, and the failure is silent:
  a release build that quietly accepts plaintext HTTP to an attacker-chosen
  host on those addresses.

  The development exceptions now live in src/debug/res/xml/, which Gradle
  merges into debug builds only. A release build cannot contain them, because
  the file is not part of it.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
