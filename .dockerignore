# The API image is Python-only. `COPY . .` was pulling the entire Flutter app
# (including build output and the Android/iOS toolchains' artifacts) into a
# python:3.12-slim image — hundreds of MB of files the service never reads,
# paid for on every build and every cold start.

# Flutter / mobile
frontend/
ironlink_admin/

# Secrets — must never reach an image layer
.env
.env.*
!.env.example
secrets/
*.pem
*.key
*.crt
**/google-services.json
**/GoogleService-Info.plist
**/firebase-service-account*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# VCS / CI / docs
.git/
.github/
.gitignore
*.md
!README.md

# Local infra that has no meaning inside the image
docker-compose*.yml
nginx/
pg_data/
redis_data/
minio_data/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
